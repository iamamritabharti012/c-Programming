char* intToRoman(int num) {
    static char result[30];
    int values[] = {
        1000, 900, 500, 400, 100, 90,
        50, 40, 10, 9, 5, 4, 1
    };

    char* symbols[] = {
        "M", "CM", "D", "CD", "C", "XC",
        "L", "XL", "X", "IX", "V", "IV", "I"
    };

    int index = 0;
    int pos = 0;

    while (num > 0) {
        if (num >= values[index]) {
            num -= values[index];

            for (int j = 0; symbols[index][j] != '\0'; j++) {
                result[pos++] = symbols[index][j];
            }
        } else {
            index++;
        }
    }

    result[pos] = '\0';
    return result;
}
