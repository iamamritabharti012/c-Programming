int* busiestServers(int k, int* arrival, int arrivalSize,  int* load, int loadSize, int* returnSize) {

    int *count = (int*)calloc(k, sizeof(int));
    int *busy = (int*)malloc(k * sizeof(int));

    for (int i = 0; i < k; i++) {
        busy[i] = 0;
    }

    for (int i = 0; i < arrivalSize; i++) {

        int server = i % k;
        int found = 0;

        for (int j = 0; j < k; j++) {
            int s = (server + j) % k;

            if (busy[s] <= arrival[i]) {
                busy[s] = arrival[i] + load[i];
                count[s]++;
                found = 1;
                break;
            }
        }
    }

    int maxCount = 0;

    for (int i = 0; i < k; i++) {
        if (count[i] > maxCount) {
            maxCount = count[i];
        }
    }

    int *result = (int*)malloc(k * sizeof(int));
    *returnSize = 0;

    for (int i = 0; i < k; i++) {
        if (count[i] == maxCount) {
            result[(*returnSize)++] = i;
        }
    }

    free(count);
    free(busy);

    return result;
}
